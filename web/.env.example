[TEMPLATE]
# The Next.js server proxies /api/v1/* to the backend (see next.config.ts).
# Point this at the real backend for production.
BACKEND_URL=http://localhost:8080

# Server-side backend URL used by the org portal's server actions, session
# route handler and middleware gate. Defaults to the same value as BACKEND_URL;
# set it explicitly when the two differ (e.g. a private network hop).
API_SERVER_URL=http://localhost:8080

# Public origin of the backend (e.g. https://auth.example.com). When set, the
# dashboards show it combined with the platform slug as the copyable project
# URL (BACKEND_PUBLIC_URL/{slug} — no /api/v1). Read at runtime by the console
# layout and the org portal's server pages.
BACKEND_PUBLIC_URL=http://localhost:8080

# Optional: call the API directly from the browser instead of proxying (no
# /api/v1 — the backend serves at the clean root origin). The backend must
# allow CORS for this origin in that case.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
