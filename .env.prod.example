# Copy to .env and fill in real values:  cp .env.prod.example .env
# Then:  docker compose -f compose.prod.yaml up -d --build

# --- REQUIRED ---
# HS256 signing secret (>= 32 bytes). Generate one with:
#   openssl rand -base64 48
# Keep it stable — changing it invalidates every issued access token.
JWT_SECRET=

# --- Database (defaults match the postgres service; change the password) ---
POSTGRES_DB=nexxauth
POSTGRES_USER=nexxauth
POSTGRES_PASSWORD=nexxauth

# --- Optional overrides ---
# Ports exposed on the host.
# BACKEND_PORT=8080
# MANAGEMENT_PORT=8081
# WEB_PORT=3000

# Deployment environment label for the ECS logs.
# ENVIRONMENT=production

# --- Public domains ---
# The backend's and console's public URLs. CORS_ALLOWED_ORIGINS defaults to
# WEB_PUBLIC_URL, so the API only answers cross-origin browser calls from the
# console's domain (org-level per-client CORS is still enforced separately).
# Set both when the stack is behind a reverse proxy / DNS name.
# BACKEND_PUBLIC_URL=https://api.example.com
# WEB_PUBLIC_URL=https://app.example.com
# Comma-separated extra origins allowed to call the API directly from browsers.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://portal.example.com

# Set true only when a trusted reverse proxy in front sets X-Forwarded-For.
# APP_RATE_LIMIT_USE_FORWARDED_FOR=false
