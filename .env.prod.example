# Copy to .env and fill in real values:  cp .env.prod.example .env
# Then:  docker compose -f compose.prod.yaml up -d --build

# --- REQUIRED ---
# HS256 signing secret (>= 32 bytes). Generate one with:
#   openssl rand -base64 48
# Keep it stable — changing it invalidates every issued access token.
JWT_SECRET=

# --- Database (defaults match the postgres service; change the password) ---
POSTGRES_DB=nexxauth
POSTGRES_USER=nexxauth
POSTGRES_PASSWORD=nexxauth

# --- Optional overrides ---
# Ports exposed on the host.
# BACKEND_PORT=8080
# MANAGEMENT_PORT=8081
# WEB_PORT=3000

# Deployment environment label for the ECS logs.
# ENVIRONMENT=production

# Set true only when a trusted reverse proxy in front sets X-Forwarded-For.
# APP_RATE_LIMIT_USE_FORWARDED_FOR=false
